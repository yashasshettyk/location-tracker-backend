# For LOCAL dev only. On Vercel itself, set API_KEY in the dashboard under
# Project Settings > Environment Variables — this file is never used there.
#
# POSTGRES_URL and friends don't need to be typed in by hand: after you attach
# a Postgres database to the project in the Vercel dashboard (Storage tab),
# run `vercel env pull .env` to copy all the real values down here automatically.

# Secret key the Android app must send in the "x-api-key" header.
# Generate one with: openssl rand -hex 24
API_KEY=change-this-to-a-long-random-secret

# Filled in automatically by `vercel env pull .env` once Postgres is attached.
# POSTGRES_URL=
